# Näidis. Päris väärtused lähevad Verceli Settings → Environment Variables (ära pane neid koodi ega gitti).

# MailerSend (kirjade saatmine)
MAILERSEND_API_TOKEN=
MAIL_FROM=info@squeakycleanteenused.ee

# Supabase (serveri poolt, ootelisti salvestus). Service role võti on salajane, ainult serveris.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (valikuline). Lülitub sisse ainult siis, kui MÕLEMAD on täidetud.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Valikuline
# Kinnituslinkide aadress (vaikimisi https://www.squeakycleanteenused.ee). Testimiseks nt http://localhost:3000
PUBLIC_SITE_URL=
# Lisapipar IP-räsile (vaikimisi kasutatakse SUPABASE_SERVICE_ROLE_KEY-d)
WAITLIST_SALT=
